# Vision 图片识别服务
# 文件: vision.yaml — 环境变量: QIANXUE_VISION__ENABLED=false

enabled: true
provider: "qwen"
model: "qwen-vl-max"
api_key: ""               # 留空则使用 LLM thinking_provider 的 key
base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
max_retries: 3
timeout: 30               # API 调用超时（秒）

image_download:
  timeout: 15.0           # 图片下载超时（秒）
