# Discord Bot 配置
# 文件: discord.yaml -- 环境变量: QIANXUE_DISCORD__TOKEN=your-bot-token

# Discord Bot Token -- 从 Discord Developer Portal 获取
# 生产环境建议通过环境变量 QIANXUE_DISCORD__TOKEN 覆盖
token: ""

# HTTP 代理地址（中国大陆用户连接 Discord 需要）
# 留空或不设置则不使用代理
proxy: ""

# 监听的文字频道 ID 列表（只有这些频道的消息会被处理）
channels: []
  # - 1234567890123456789

# 是否接受私聊（DM）消息
dm_enabled: true

# Bot 连接超时（秒）
connect_timeout: 30

# 默认语音频道 ID -- connect_discord 连接时自动加入此频道
# 设置为 null 则不自动加入语音频道
voice_channel_id: null
  # - 123456789012345678

# 语音附件转写设置
voice:
  # 最大语音附件大小（字节），超过此大小跳过转写
  max_size: 26214400  # 25MB
  # 是否自动自动转写语音附件
  auto_transcribe: true
